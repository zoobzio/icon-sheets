{
  "name": "@icon-sheets/kit",
  "version": "0.0.3",
  "description": "Preset builder for icon-sheets \u2014 turns one ref config into a publishable package of aliases, guard, contract, sets and sprites",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/icon-sheets.git",
    "directory": "packages/kit"
  },
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.mjs"
    }
  },
  "bin": {
    "icon-sheets": "./.dist/cli.mjs"
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@icon-sheets/iconify": "workspace:*",
    "@icon-sheets/schema": "workspace:*",
    "@icon-sheets/svg": "workspace:*",
    "@icon-sheets/utils": "workspace:*",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@iconify/types": "^2.0.0",
    "@types/node": "^25.9.1",
    "icon-sheets": "workspace:*"
  }
}
