{
  "name": "icon-sheets",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/icon-sheets.git",
    "directory": "packages/icon-sheets"
  },
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.mjs"
    },
    "./config": {
      "types": "./.dist/config.d.ts",
      "import": "./.dist/config.mjs"
    },
    "./catalog": {
      "types": "./.dist/catalog.d.ts",
      "import": "./.dist/catalog.mjs"
    },
    "./svg": {
      "types": "./.dist/svg.d.ts",
      "import": "./.dist/svg.mjs"
    }
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@icon-sheets/catalog": "workspace:*",
    "@icon-sheets/core": "workspace:*",
    "@icon-sheets/schema": "workspace:*",
    "@icon-sheets/svg": "workspace:*",
    "@icon-sheets/utils": "workspace:*"
  }
}
