{
  "name": "@icon-sheets/iconify",
  "version": "0.0.7",
  "description": "Iconify ref resolution for icon-sheets — resolves Iconify references into validated contracts and sets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/icon-sheets.git",
    "directory": "integrations/iconify"
  },
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.mjs"
    }
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@icon-sheets/schema": "workspace:*",
    "@iconify/types": "catalog:",
    "@iconify/utils": "catalog:",
    "objectively": "catalog:"
  },
  "devDependencies": {
    "@icon-sheets/catalog": "workspace:*",
    "@types/node": "catalog:",
    "icon-sheets": "workspace:*"
  }
}
