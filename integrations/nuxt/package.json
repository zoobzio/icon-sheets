{
  "name": "@icon-sheets/nuxt",
  "version": "0.0.7",
  "description": "Nuxt module for icon-sheets — builds or consumes an @icon-sheets/kit config: SSR sprite inlining, typed Icon component, runtime set switching",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/icon-sheets.git",
    "directory": "integrations/nuxt"
  },
  "type": "module",
  "main": "./.dist/module.mjs",
  "types": "./.dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./.dist/module.d.ts",
      "import": "./.dist/module.mjs"
    },
    "./config": {
      "types": "./.dist/config.d.ts",
      "import": "./.dist/config.mjs"
    },
    "./constant": {
      "types": "./.dist/constant.d.ts",
      "import": "./.dist/constant.mjs"
    }
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@icon-sheets/kit": "workspace:*",
    "@nuxt/kit": "catalog:",
    "h3": "catalog:",
    "icon-sheets": "workspace:*",
    "objectively": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@nuxt/nitro-server": "catalog:",
    "@nuxt/schema": "catalog:",
    "@types/node": "catalog:",
    "nuxt": "catalog:"
  }
}
